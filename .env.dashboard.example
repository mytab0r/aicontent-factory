# Hermes Dashboard environment variables
# Copy to .env.dashboard and fill in values

# Required for auth on non-loopback bind (June 2026 hardening)
# Option 1: OAuth via Nous Portal (recommended)
# Run `hermes dashboard register --name "aicontent-factory" --redirect-uri https://dashboard.pxbt.app/auth/callback`
# Then set the client ID here:
HERMES_DASHBOARD_OAUTH_CLIENT_ID=

# Option 2: Basic auth (password)
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Dashboard host/port (host network mode, so binds to host)
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119

# Optional: Portal URL for OAuth registration (default is Nous production portal)
# HERMES_DASHBOARD_PORTAL_URL=https://portal.nousresearch.com

# UID/GID for file permissions (match host user)
HERMES_UID=10000
HERMES_GID=10000
